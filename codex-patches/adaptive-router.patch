+    fn adaptive_reasoning_effort(value: &str) -> Option<ReasoningEffortConfig> {
+        match value.to_ascii_lowercase().as_str() {
+            "none" => Some(ReasoningEffortConfig::None),
+            "low" => Some(ReasoningEffortConfig::Low),
+            "medium" => Some(ReasoningEffortConfig::Medium),
+            "high" => Some(ReasoningEffortConfig::High),
+            "xhigh" => Some(ReasoningEffortConfig::XHigh),
+            "max" => Some(ReasoningEffortConfig::Max),
+            "ultra" => Some(ReasoningEffortConfig::Ultra),
+            _ => None,
+        }
+    }
+
+    fn adaptive_route_recommendation(&self, prompt: &str) -> Option<AdaptiveRouteRecommendation> {
+        if std::env::var("ADAPTIVE_MODEL_ROUTER_ENABLED")
+            .is_ok_and(|value| matches!(value.to_ascii_lowercase().as_str(), "0" | "false" | "off"))
+        {
+            return None;
+        }
+
+        let python = std::env::var("ADAPTIVE_MODEL_ROUTER_PYTHON").unwrap_or_else(|_| {
+            if cfg!(windows) {
+                "py".to_string()
+            } else {
+                "python3".to_string()
+            }
+        });
+        let mut child = std::process::Command::new(python)
+            .args(["-m", "adaptive_model_router.native_bridge"])
+            .stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::null())
+            .spawn()
+            .ok()?;
+        let request = serde_json::json!({
+            "prompt": prompt,
+            "current_model": self.current_model(),
+        });
+        if let Some(mut stdin) = child.stdin.take() {
+            serde_json::to_writer(&mut stdin, &request).ok()?;
+        }
+        let output = child.wait_with_output().ok()?;
+        if !output.status.success() {
+            return None;
+        }
+        let recommendation: AdaptiveRouteRecommendation =
+            serde_json::from_slice(&output.stdout).ok()?;
+        recommendation.enabled.then_some(recommendation)
+    }
