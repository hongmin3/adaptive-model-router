{
  "version": 3,
  "defaults": {
    "score": 5,
    "model_score": 2,
    "profile": "BALANCED",
    "reasoning": "MEDIUM",
    "confidence_threshold": 0.50,
    "uncertain_profile": "FAST",
    "uncertain_reasoning": "LOW"
  },
  "thresholds": {
    "low_max": 4,
    "medium_max": 8,
    "high_max": 14
  },
  "reasoning_order": ["low", "medium", "high", "xhigh", "max", "ultra"],
  "hook": {
    "approval_ttl_seconds": 600,
    "always_confirm": true,
    "debug": false,
    "claude_entrypoints": ["cli", "ssh-remote", "claude-coworker-terminal"]
  },
  "directives": {
    "keep_current_model": ["이 모델 그대로", "현재 모델 유지", "모델 바꾸지 마", "keep current model"],
    "reasoning": {
      "LOW": ["reasoning low", "low로 해", "사용량 아껴", "빠르게 해"],
      "MEDIUM": ["reasoning medium", "medium으로 해", "medium으로 실행"],
      "HIGH": ["reasoning high", "high로 해", "정확도가 제일 중요"],
      "XHIGH": ["reasoning xhigh", "xhigh로 해"],
      "MAX": ["reasoning max", "effort max", "max로 해", "최고 성능으로"],
      "ULTRA": ["reasoning ultra", "effort ultra", "ultra로 해"]
    }
  },
  "rules": [
    {
      "id": "narrow_simple_edit",
      "label": "narrow simple edit",
      "score": -4,
      "model_score": -2,
      "confidence_conflict": false,
      "all_of": [
        ["오타", "오탈자", "문구", "한 줄", "한줄", "파일명", "변수명", "번역", "markdown", "readme", "문자열 검색", "명령 실행"],
        ["수정", "변경", "추가", "정리", "바꿔", "고쳐", "번역", "검색", "실행"]
      ],
      "none_of": ["프로젝트 전체", "전체 구조", "모든 파일", "전수", "대규모", "여러 모듈", "근본 원인"]
    },
    {
      "id": "normal_implementation",
      "label": "general implementation",
      "score": 1,
      "model_score": 4,
      "any_of": ["기능 구현", "기능을 구현", "기능 추가", "자동화 기능", "자동화 구현", "python 자동화", "shell script", "shell 스크립트", "api 연동", "endpoint를 구현", "endpoint 구현", "엔드포인트를 새로 만들어", "버그 수정", "오류 수정", "테스트 코드", "데이터 가공", "설정 변경"]
    },
    {
      "id": "multiple_files",
      "label": "multiple files",
      "score": 2,
      "model_score": 3,
      "any_of": ["여러 파일", "다중 파일", "복수 파일", "multiple files"]
    },
    {
      "id": "project_wide_analysis",
      "label": "project-wide analysis",
      "score": 4,
      "model_score": 7,
      "all_of": [
        ["프로젝트 전체", "전체 프로젝트", "전체 코드베이스", "전체 구조", "전체 저장소", "모든 파일", "all files", "전수"],
        ["분석", "확인", "검토", "리뷰", "review", "점검", "개선", "리팩터링", "refactor"]
      ]
    },
    {
      "id": "architecture_work",
      "label": "architecture or refactoring work",
      "score": 4,
      "model_score": 7,
      "all_of": [
        ["architecture", "아키텍처", "구조", "refactoring", "리팩터링", "설계"],
        ["분석", "개선", "재설계", "검토", "리팩터링", "refactor", "문제점"]
      ],
      "none_of": ["readme에", "readme 안", "문서에", "단어", "문구", "한 줄", "한줄"]
    },
    {
      "id": "complex_debugging",
      "label": "complex debugging",
      "score": 4,
      "model_score": 7,
      "any_of": ["근본 원인", "원인 불명", "복잡한 버그", "race condition", "concurrency", "synchronization", "동시성 경합", "교착", "deadlock", "성능 병목"]
    },
    {
      "id": "multi_module_dependency",
      "label": "multiple modules or dependency analysis",
      "score": 2,
      "model_score": 4,
      "any_of": ["여러 모듈", "모듈 간", "의존성 분석", "의존 관계", "dependency analysis", "side effect", "사이드 이펙트"]
    },
    {
      "id": "analysis_and_implementation",
      "label": "analysis and implementation",
      "score": 2,
      "model_score": 3,
      "all_of": [
        ["분석", "원인", "검토", "확인"],
        ["수정", "구현", "개선해줘", "개선하고", "개선한 뒤", "적용", "리팩터링"]
      ]
    },
    {
      "id": "verification_required",
      "label": "testing or verification required",
      "score": 1,
      "model_score": 1,
      "any_of": ["테스트", "검증", "빌드", "lint", "린트", "type check", "타입 검사"]
    },
    {
      "id": "high_impact_operation",
      "label": "high-impact operation",
      "score": 9,
      "model_score": 10,
      "risk_floor": "HIGH",
      "literal_mentions": ["security라는 단어", "security 단어", "security 문자열", "보안이라는 단어", "보안 단어", "production이라는 문자열"],
      "any_of": ["db migration", "database migration", "스키마 마이그레이션", "production config", "운영 설정", "운영 서버", "운영 db", "production deploy", "production", "프로덕션", "prod deploy", "백업을 삭제", "백업 삭제", "대량 삭제", "권한 변경", "인증 변경", "보안 코드", "보안 취약점", "security", "destructive"]
    },
    {
      "id": "mechanical_wide_edit",
      "label": "mechanical change across a broad scope",
      "score": -4,
      "model_score": 7,
      "confidence_conflict": false,
      "all_of": [
        ["여러 파일", "다중 파일", "전체 코드베이스", "프로젝트 전체", "모든 파일", "전수", "multiple files", "across files"],
        ["이름 변경", "rename", "리네임", "문자열 교체", "일괄 교체", "일괄 변경", "일괄 수정", "replace all occurrences"]
      ]
    },
    {
      "id": "focused_hard_reasoning",
      "label": "focused hard reasoning",
      "score": 4,
      "model_score": 4,
      "any_of": ["알고리즘", "algorithm", "수학적 증명", "복잡도 분석", "complexity analysis", "sql 쿼리 최적화"],
      "none_of": ["explain this algorithm", "알고리즘을 간단히 설명", "알고리즘 설명만"]
    },
    {
      "id": "code_review",
      "label": "code review",
      "score": 1,
      "model_score": 4,
      "any_of": ["코드 리뷰", "코드를 검토", "code review", "review this code"]
    },
    {
      "id": "bug_discovery",
      "label": "bug discovery",
      "score": 1,
      "model_score": 4,
      "all_of": [["버그", "bug"], ["찾아", "찾기", "find", "뭐야"]],
      "none_of": ["복잡한 버그", "원인 불명", "근본 원인"]
    },
    {
      "id": "bug_diagnosis",
      "label": "bug diagnosis",
      "score": 1,
      "model_score": 4,
      "all_of": [["오류", "에러", "error", "버그", "bug", "실패"], ["원인", "분석", "진단", "조사", "찾아", "확인", "investigate", "diagnose"]],
      "none_of": ["수정", "고쳐", "fix", "구현", "버그를 찾아", "버그가 뭐", "복잡한 버그", "원인 불명", "근본 원인"]
    }
  ],
  "model_selection": {
    "reasoning_tie_break": "up",
    "exclude_description_terms": ["previous-generation", "deprecated"],
    "slug_role_patterns": {
      "FAST": ["-luna(?:$|-)"],
      "BALANCED": ["-terra(?:$|-)"],
      "STRONG": ["-sol(?:$|-)"],
      "MAX": ["-astra(?:$|-)"]
    },
    "fallback_profiles": {
      "FAST": ["BALANCED", "STRONG", "MAX"],
      "BALANCED": ["STRONG", "FAST", "MAX"],
      "STRONG": ["BALANCED", "MAX", "FAST"],
      "MAX": ["STRONG", "BALANCED", "FAST"]
    },
    "description_hints": {
      "FAST": ["fast", "affordable", "low latency", "cost-effective"],
      "BALANCED": ["balanced", "everyday", "workhorse"],
      "STRONG": ["reliable", "complex", "demanding"],
      "MAX": ["most capable", "hardest"]
    }
  },
  "providers": {
    "codex": {
      "label": "Codex",
      "reasoning_label": "Reasoning",
      "default_family": "openai",
      "families": {
        "openai": {
          "label": "GPT",
          "catalog_path": "~/.codex/models_cache.json",
          "slug_patterns": ["^gpt", "^o[1-9]", "^codex-"],
          "refresh_via_cli": true,
          "profile_models": {}
        },
        "deepseek": {
          "label": "DeepSeek",
          "catalog_path": "~/.codex/router/deepseek-models.json",
          "slug_patterns": ["^deepseek"],
          "profile_models": {
            "FAST": ["deepseek-flash"],
            "BALANCED": ["deepseek-flash"],
            "STRONG": ["deepseek-v4-pro"],
            "MAX": ["deepseek-v4-pro"]
          }
        }
      }
    },
    "claude": {
      "label": "Claude Code",
      "reasoning_label": "Effort",
      "default_family": "anthropic",
      "default_efforts": ["low", "medium", "high", "xhigh", "max"],
      "families": {
        "anthropic": {
          "label": "",
          "profile_models": {
            "FAST": ["haiku"],
            "BALANCED": ["sonnet"],
            "STRONG": ["opus"],
            "MAX": ["fable"]
          }
        }
      },
      "verified_alias_families": {
        "haiku": {"profile": "FAST", "description": "Fastest for quick answers"},
        "sonnet": {"profile": "BALANCED", "description": "Most efficient for everyday tasks"},
        "opus": {"profile": "STRONG", "description": "Most capable for ambitious work"},
        "fable": {"profile": "MAX", "description": "For your toughest challenges"}
      }
    }
  },
  "ai_fallback": {
    "enabled": false,
    "policy": "Never call an LLM for routing. Low-confidence results use the cost-safe FAST/LOW fallback."
  }
}
